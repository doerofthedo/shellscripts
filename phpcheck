#!/bin/bash
set -euo pipefail
export LC_ALL=C

# Minimum upstream releases fixing CVE-2026-109618 and CVE-2026-109619.
declare -Ar SAFE_VERSION=(
	["8.2"]=8.2.35
	["8.3"]=8.3.36
	["8.4"]=8.4.27
	["8.5"]=8.5.12
)

# The PHP security team published minimal source-only backports for these EOL
# branches. There is no new upstream release number to compare, so an installed
# Debian/Ubuntu package is accepted only when vendor package-version data or
# its installed changelog proves that both CVEs were backported.
declare -Ar EOL_SOURCE_BACKPORT=(
	["7.4"]=1
	["8.0"]=1
	["8.1"]=1
)

# Ubuntu Security Notice USN-8948-1 fixed package versions. These are
# deliberately full Debian package versions: Ubuntu backports the fixes while
# retaining the PHP version originally shipped with each release.
declare -Ar UBUNTU_SAFE_VERSION=(
	["22.04:8.1"]=8.1.2-1ubuntu2.28
	["24.04:8.3"]=8.3.6-0ubuntu0.24.04.13
	["26.04:8.5"]=8.5.4-0ubuntu1.5
	["26.10:8.5"]=8.5.9-0ubuntu2.1
)

declare -Ar UBUNTU_VERSION_BY_CODENAME=(
	["jammy"]=22.04
	["noble"]=24.04
	["resolute"]=26.04
	["stonking"]=26.10
)

UPDATE=0
NO_COLOR_REQUESTED=0

usage() {
	cat <<'EOF'
Usage: phpcheck [--update] [--no-color]

Audits installed Debian/Ubuntu PHP packages. It checks:
  - PHP core packages for fixes to CVE-2026-109618 and CVE-2026-109619,
    including PHP's minimal source backports for 7.4, 8.0, and 8.1 when
    recorded by the package vendor, plus known Ubuntu backports;
    upstream-EOL branches are identified separately
  - every installed php*, libapache2-mod-php*, and libphp*-embed package
    against its current APT candidate

Options:
  --update     Run apt-get update before checking (requires root)
  --no-color   Disable colored output
  -h, --help   Show this help

Exit status:
  0  Both scoped CVEs are fixed and no package upgrades are pending
  1  A fix is unverified, a package issue was found, or an APT check failed
  2  Usage error or a required command is missing

APT package status:
  apt-current       Installed version equals APT's current candidate
  OUTDATED          APT offers a newer candidate
  newer-than-repo   Installed version is newer than APT's candidate
  UNKNOWN           APT has no candidate for the installed package
  APT-ERROR         APT candidate lookup failed

APT metadata is local. Use --update to refresh it before the audit.
EOF
}

for arg in "$@"; do
	case "$arg" in
		--update) UPDATE=1 ;;
		--no-color) NO_COLOR_REQUESTED=1 ;;
		-h | --help)
			usage
			exit 0
			;;
		*)
			echo "Unknown argument: $arg" >&2
			usage >&2
			exit 2
			;;
	esac
done

if [[ "$NO_COLOR_REQUESTED" -eq 1 || -n ${NO_COLOR:-} || ! -t 1 ]]; then
	RED=""
	GREEN=""
	YELLOW=""
	BLUE=""
	RESET=""
else
	RED=$'\e[31m'
	GREEN=$'\e[32m'
	YELLOW=$'\e[33m'
	BLUE=$'\e[34m'
	RESET=$'\e[0m'
fi

die() {
	printf '%bERROR:%b %s\n' "$RED" "$RESET" "$*" >&2
	exit 2
}

for cmd in apt-cache awk dpkg dpkg-query grep sort zgrep; do
	command -v "$cmd" >/dev/null 2>&1 || die "Missing required command: $cmd"
done

if [[ "$UPDATE" -eq 1 ]]; then
	command -v apt-get >/dev/null 2>&1 || die "Missing required command: apt-get"
	[[ ${EUID:-$(id -u)} -eq 0 ]] || die "--update must be run as root or with sudo"
	printf '%bUpdating APT package lists...%b\n' "$BLUE" "$RESET"
	if ! apt-get update; then
		printf '%bERROR:%b APT package-list update failed; package candidates were not checked.\n' \
			"$RED" "$RESET" >&2
		exit 1
	fi
fi

if ! package_output=$(dpkg-query -W \
	-f='${binary:Package}\t${Version}\t${source:Package}\t${source:Version}\t${db:Status-Abbrev}\n' 2>&1); then
	die "Unable to read the dpkg package database: ${package_output//$'\n'/ }"
fi

if ! inventory_output=$(
	awk -F '\t' '
		$5 ~ /^ii/ && ($1 ~ /^php/ || $1 ~ /^libapache2-mod-php/ || $1 ~ /^libphp[0-9]+\.[0-9]+-embed(:|$)/) {
			print $1 "\t" $2 "\t" $3 "\t" $4
		}
	' <<<"$package_output" | sort -t $'\t' -k1,1V
); then
	die "Unable to process the dpkg package inventory"
fi

declare -a package_rows=()
if [[ -n $inventory_output ]]; then
	mapfile -t package_rows <<<"$inventory_output"
fi

if ((${#package_rows[@]} == 0)); then
	printf '%bNo installed PHP packages found.%b\n' "$YELLOW" "$RESET"
	exit 0
fi

declare -A branch_count=()
declare -A branch_core_count=()
declare -A branch_source=()
declare -A branch_source_version=()
declare -A branch_doc_package=()
declare -A branch_mixed_versions=()

for row in "${package_rows[@]}"; do
	IFS=$'\t' read -r package installed source source_version <<<"$row"
	base_package=${package%%:*}
	branch=""

	if [[ $base_package =~ ^php([0-9]+\.[0-9]+)(-|$) ]]; then
		branch=${BASH_REMATCH[1]}
	elif [[ $base_package =~ ^libapache2-mod-php([0-9]+\.[0-9]+)$ ]]; then
		branch=${BASH_REMATCH[1]}
	elif [[ $base_package =~ ^libphp([0-9]+\.[0-9]+)-embed$ ]]; then
		branch=${BASH_REMATCH[1]}
	fi

	if [[ -n $branch ]]; then
		branch_count[$branch]=$((${branch_count[$branch]:-0} + 1))
		if [[ $source == "php$branch" ]]; then
			branch_core_count[$branch]=$((${branch_core_count[$branch]:-0} + 1))
			branch_source[$branch]=$source
			if [[ -z ${branch_source_version[$branch]:-} ]]; then
				branch_source_version[$branch]=$source_version
				branch_doc_package[$branch]=$base_package
			else
				if [[ $source_version != "${branch_source_version[$branch]}" ]]; then
					branch_mixed_versions[$branch]=1
				fi
				if dpkg --compare-versions "$source_version" lt "${branch_source_version[$branch]}"; then
					branch_source_version[$branch]=$source_version
					branch_doc_package[$branch]=$base_package
				elif [[ $source_version == "${branch_source_version[$branch]}" && $base_package == "php$branch-common" ]]; then
					branch_doc_package[$branch]=$base_package
				fi
			fi
		fi
	fi
done

os_id=""
os_id_like=""
os_version_id=""
ubuntu_codename=""
ubuntu_version=""
if [[ -r /etc/os-release ]]; then
	os_id=$(awk -F= '$1 == "ID" {gsub(/^"|"$/, "", $2); print $2}' /etc/os-release)
	os_id_like=$(awk -F= '$1 == "ID_LIKE" {gsub(/^"|"$/, "", $2); print $2}' /etc/os-release)
	os_version_id=$(awk -F= '$1 == "VERSION_ID" {gsub(/^"|"$/, "", $2); print $2}' /etc/os-release)
	ubuntu_codename=$(awk -F= '$1 == "UBUNTU_CODENAME" {gsub(/^"|"$/, "", $2); print $2}' /etc/os-release)
fi

if [[ $os_id == ubuntu ]]; then
	ubuntu_version=$os_version_id
elif [[ " $os_id_like " == *" ubuntu "* && -n $ubuntu_codename ]]; then
	ubuntu_version=${UBUNTU_VERSION_BY_CODENAME[$ubuntu_codename]:-}
fi

upstream_version() {
	local version=${1#*:}
	if [[ $version =~ ^([0-9]+\.[0-9]+\.[0-9]+) ]]; then
		printf '%s\n' "${BASH_REMATCH[1]}"
	fi
}

changelog_contains() {
	local package=${1%%:*}
	local needle=$2
	local file
	local -a changelogs=()

	shopt -s nullglob
	changelogs=("/usr/share/doc/$package"/changelog*)
	shopt -u nullglob

	for file in "${changelogs[@]}"; do
		if [[ $file == *.gz ]]; then
			if zgrep -Fq -- "$needle" "$file" 2>/dev/null; then
				return 0
			fi
		elif grep -Fq -- "$needle" "$file" 2>/dev/null; then
			return 0
		fi
	done

	return 1
}

issues=0
eol_branches=0
declare -a apt_errors=()

printf '%bPHP security release check%b\n' "$BLUE" "$RESET"
printf '  Fixes checked: CVE-2026-109618, CVE-2026-109619\n'

if ((${#branch_count[@]} == 0)); then
	printf '  %bWARN%b No versioned PHP runtime packages were detected.\n' "$YELLOW" "$RESET"
	issues=$((issues + 1))
else
	mapfile -t branches < <(printf '%s\n' "${!branch_count[@]}" | sort -V)
	for branch in "${branches[@]}"; do
		installed=${branch_source_version[$branch]:-}
		source=${branch_source[$branch]:-}
		doc_package=${branch_doc_package[$branch]:-}
		minimum=${SAFE_VERSION[$branch]:-}
		vendor_minimum=""
		vendor_key=""
		fixed=0
		evidence=""
		installed_upstream=$(upstream_version "$installed")

		if [[ -n $ubuntu_version ]]; then
			vendor_key="$ubuntu_version:$branch"
			vendor_minimum=${UBUNTU_SAFE_VERSION[$vendor_key]:-}
		fi

		if [[ -z $installed ]]; then
			printf '  %bFAIL%b PHP %-4s cannot determine its core source-package version (%d packages)\n' \
				"$RED" "$RESET" "$branch" "${branch_count[$branch]}"
			issues=$((issues + 1))
		elif [[ -n $minimum && -n $installed_upstream ]] &&
			dpkg --compare-versions "$installed_upstream" ge "$minimum"; then
			fixed=1
			evidence="upstream $installed_upstream >= fixed release $minimum"
		elif [[ -n $vendor_minimum && $installed == *ubuntu* && $installed != *+* ]] &&
			dpkg --compare-versions "$installed" ge "$vendor_minimum"; then
			fixed=1
			evidence="Ubuntu $ubuntu_version package >= $vendor_minimum (USN-8948-1)"
		elif [[ -n $doc_package ]] &&
			changelog_contains "$doc_package" CVE-2026-109618 &&
			changelog_contains "$doc_package" CVE-2026-109619; then
			fixed=1
			if [[ -n ${EOL_SOURCE_BACKPORT[$branch]:-} ]]; then
				evidence="installed changelog records both CVEs (PHP $branch minimal source backport)"
			else
				evidence="both CVEs are recorded in $doc_package installed changelog"
			fi
		else
			printf '%bUNVERIFIED%b PHP %s\n' "$RED" "$RESET" "$branch"
			printf '    source package: %s\n' "$source"
			printf '    installed:      %s\n' "$installed"
			if [[ -n $minimum ]]; then
				printf '    evidence:       upstream release is below %s and no vendor backport evidence was found\n' "$minimum"
			elif [[ -n ${EOL_SOURCE_BACKPORT[$branch]:-} ]]; then
				printf '    evidence:       PHP published a minimal source backport, but this package has no proof that it includes both fixes\n'
			else
				printf '    evidence:       no upstream baseline or vendor backport evidence was found\n'
			fi
			issues=$((issues + 1))
		fi

		if [[ $fixed -eq 1 ]]; then
			if [[ -n $minimum ]]; then
				printf '%bSAFE%b PHP %s\n' "$GREEN" "$RESET" "$branch"
			elif [[ -n ${EOL_SOURCE_BACKPORT[$branch]:-} ]]; then
				printf '%bCVE-FIXED%b PHP %s [upstream-EOL]\n' "$YELLOW" "$RESET" "$branch"
				eol_branches=$((eol_branches + 1))
			else
				printf '%bCVE-FIXED%b PHP %s [no upstream baseline]\n' "$YELLOW" "$RESET" "$branch"
			fi
			printf '    source package: %s\n' "$source"
			printf '    installed:      %s\n' "$installed"
			printf '    evidence:       %s\n' "$evidence"
			if [[ -n ${EOL_SOURCE_BACKPORT[$branch]:-} ]]; then
				printf '    lifecycle:      upstream EOL; only the scoped CVE fixes are verified\n'
			elif [[ -z $minimum ]]; then
				printf '    lifecycle:      not modeled; only the scoped CVE fixes are verified\n'
			fi
		fi

		printf '    packages:       %d core, %d total for this branch\n' \
			"${branch_core_count[$branch]:-0}" "${branch_count[$branch]}"
		if [[ ${branch_mixed_versions[$branch]:-0} -eq 1 ]]; then
			printf '    %bwarning:%b        mixed PHP core source-package versions are installed\n' \
				"$YELLOW" "$RESET"
			issues=$((issues + 1))
		fi
	done
fi

printf '\n%bAPT package status%b\n' "$BLUE" "$RESET"
if [[ $UPDATE -eq 1 ]]; then
	printf '  Metadata: refresh requested before check\n\n'
else
	printf '  Metadata: cached (use --update to refresh)\n\n'
fi

print_package() {
	local package=$1
	local source=$2
	local installed=$3
	local candidate=$4
	local status=$5

	printf '%s [%b]\n' "$package" "$status"
	printf '    source package: %s\n' "$source"
	printf '    installed:      %s\n' "$installed"
	printf '    candidate:      %s\n\n' "$candidate"
}

declare -a package_names=()
declare -A apt_candidate=()
policy_failed=0
policy_error=""

for row in "${package_rows[@]}"; do
	IFS=$'\t' read -r package _ <<<"$row"
	package_names+=("$package")
done

if policy_output=$(apt-cache policy "${package_names[@]}" 2>&1); then
	while IFS=$'\t' read -r policy_package candidate; do
		apt_candidate[$policy_package]=$candidate
	done < <(
		awk '
			/^[^[:space:]]/ && /:$/ {
				package = $0
				sub(/:$/, "", package)
			}
			$1 == "Candidate:" { print package "\t" $2 }
		' <<<"$policy_output"
	)
else
	policy_failed=1
	policy_error=${policy_output//$'\n'/ }
	apt_errors+=("apt-cache policy: $policy_error")
fi

for row in "${package_rows[@]}"; do
	IFS=$'\t' read -r package installed source source_version <<<"$row"
	if ((policy_failed)); then
		candidate="(error)"
		status="${RED}APT-ERROR${RESET}"
		issues=$((issues + 1))
		print_package "$package" "$source" "$installed" "$candidate" "$status"
		continue
	fi

	candidate=${apt_candidate[$package]-}
	if [[ -z $candidate ]]; then
		candidate=${apt_candidate[${package%%:*}]-}
	fi

	if [[ -z $candidate || $candidate == "(none)" ]]; then
		status="${YELLOW}UNKNOWN${RESET}"
		candidate="(none)"
		issues=$((issues + 1))
	elif dpkg --compare-versions "$installed" eq "$candidate"; then
		status="${GREEN}apt-current${RESET}"
	elif dpkg --compare-versions "$installed" lt "$candidate"; then
		status="${RED}OUTDATED${RESET}"
		issues=$((issues + 1))
	else
		status="${YELLOW}newer-than-repo${RESET}"
	fi

	print_package "$package" "$source" "$installed" "$candidate" "$status"
done

if ((${#apt_errors[@]} > 0)); then
	printf '%bAPT errors:%b\n' "$RED" "$RESET"
	printf '  %s\n' "${apt_errors[@]}"
	printf '\n'
fi

if ((issues == 0)); then
	printf '%bPASS:%b all detected PHP core packages contain both fixes; no PHP package upgrades are pending (%d checked).\n' \
		"$GREEN" "$RESET" "${#package_rows[@]}"
	if ((eol_branches > 0)); then
		printf '%bNOTICE:%b %d upstream-EOL PHP branch(es) detected; PASS applies only to the two scoped CVEs.\n' \
			"$YELLOW" "$RESET" "$eol_branches"
	fi
	exit 0
fi

printf '%bFAIL:%b found %d issue(s). Run %s with --update if the APT cache may be stale.\n' \
	"$RED" "$RESET" "$issues" "sudo phpcheck"
printf 'UNVERIFIED means no upstream-version, known vendor-version, or installed-changelog proof was found.\n'
exit 1
